# Скопируйте в .env и заполните. Ключи в репозиторий не коммитить.

# Модель агента: OpenAI-совместимый шлюз (RouterAI, OpenRouter, Ollama /v1)
NUXT_LLM_BASE_URL=https://routerai.ru/api/v1
NUXT_LLM_API_KEY=
NUXT_LLM_MODEL=anthropic/claude-haiku-5.5
NUXT_LLM_MODEL_STRONG=anthropic/claude-sonnet-5.5

# Или прямой Anthropic (если задан — главнее шлюза)
NUXT_ANTHROPIC_API_KEY=
NUXT_ANTHROPIC_MODEL=claude-haiku-5-5

# Или локальная Ollama (0 ₽, ПДн не уходят наружу). Явный выбор: NUXT_LLM_PROVIDER=gateway|anthropic|ollama
NUXT_LLM_PROVIDER=
NUXT_OLLAMA_BASE_URL=http://localhost:11434/v1
NUXT_OLLAMA_MODEL=qwen3.5:9b

# Эмбеддинги (по умолчанию локальная Ollama, bge-m3, размерность 1024)
NUXT_EMBED_BASE_URL=http://localhost:11434/v1
NUXT_EMBED_API_KEY=
NUXT_EMBED_MODEL=bge-m3

# Почта (необязательно: без SMTP письма пишутся в журнал, без IMAP канал почты выключен)
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM=
NUXT_IMAP_HOST=
NUXT_IMAP_PORT=993
NUXT_IMAP_USER=
NUXT_IMAP_PASS=

# Вход в панель менеджера
# Длинная случайная строка; пусто = панель закрыта
NUXT_MANAGER_TOKEN=

# Публичный чат: лимит сообщений в минуту на весь процесс (на один адрес — 12)
NUXT_CHAT_GLOBAL_PER_MIN=120
# 1 — стенд за своим обратным прокси: адрес клиента берётся из X-Forwarded-For
NUXT_TRUST_PROXY=

# Канал Telegram (необязательно: без токена канал выключен)
# Токен бота от @BotFather
NUXT_TELEGRAM_BOT_TOKEN=
# Секрет вебхука: длинная случайная строка из латиницы, цифр, _ и -; без него вебхук не принимает запросы
NUXT_TELEGRAM_WEBHOOK_SECRET=
# Адрес Bot API; пусто = https://api.telegram.org (поменять, если стенд ходит в Telegram через прокси)
NUXT_TELEGRAM_API_URL=
# Публичный адрес стенда для npm run telegram:webhook, например https://example.ru (путь /api/telegram/webhook скрипт допишет сам)
NUXT_TELEGRAM_PUBLIC_URL=

# Пароль базы для docker compose
POSTGRES_PASSWORD=
